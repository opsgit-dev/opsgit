{
  "$schema": "../schema/flag.schema.json",
  "key": "new_checkout_v2",
  "description": "Redesigned multi-step checkout flow",
  "owner": "payments-team",
  "client": true,
  "tags": [
    "checkout",
    "experiment"
  ],
  "enabled": true,
  "default": false,
  "rules": [
    {
      "name": "staging-everyone",
      "conditions": [
        {
          "attribute": "environment",
          "operator": "eq",
          "value": "staging"
        }
      ],
      "value": true
    },
    {
      "name": "beta-testers",
      "conditions": [
        {
          "segment": "beta_testers"
        }
      ],
      "value": true
    },
    {
      "name": "north-america-50pct",
      "conditions": [
        {
          "attribute": "country",
          "operator": "in",
          "value": [
            "US",
            "CA"
          ]
        }
      ],
      "rollout": 50,
      "value": true
    }
  ]
}
