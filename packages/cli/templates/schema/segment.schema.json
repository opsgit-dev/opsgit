{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opsgit segment",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "conditions"],
  "properties": {
    "$schema": { "type": "string" },
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,99}$", "description": "Must equal the file name without .json" },
    "description": { "type": "string" },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "description": "All must match (AND). Attribute conditions only; segments cannot nest.",
      "items": { "$ref": "flag.schema.json#/$defs/attributeCondition" }
    }
  }
}
