{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "opsgit flag",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "enabled", "default"],
  "$defs": {
    "scalar": { "type": ["string", "number", "boolean"] },
    "attributeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "operator"],
      "properties": {
        "attribute": { "type": "string", "minLength": 1 },
        "operator": {
          "enum": ["eq", "neq", "in", "not_in", "contains", "starts_with", "ends_with", "gt", "gte", "lt", "lte", "semver_eq", "semver_gt", "semver_gte", "semver_lt", "semver_lte", "exists"]
        },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/scalar" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar" } }
          ]
        }
      }
    },
    "segmentCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment"],
      "properties": { "segment": { "type": "string", "minLength": 1, "description": "Key of a file in /segments" } }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,99}$", "description": "Must equal the file name without .json" },
    "description": { "type": "string" },
    "owner": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}", "description": "ISO date after which the flag should be removed. Reported by CI, never enforced." },
    "enabled": { "type": "boolean", "description": "Master switch. When false the flag always serves default." },
    "default": { "description": "Served when disabled or when no rule matches. Any JSON value." },
    "rules": {
      "type": "array",
      "description": "Evaluated in order, first match wins. Conditions within a rule are ANDed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "conditions", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": { "oneOf": [{ "$ref": "#/$defs/attributeCondition" }, { "$ref": "#/$defs/segmentCondition" }] }
          },
          "rollout": { "type": "number", "minimum": 0, "maximum": 100, "description": "Percent of matching contexts that get value. Default 100." },
          "bucket_by": { "type": "string", "minLength": 1, "description": "Context attribute used for deterministic bucketing. Default user_id." },
          "value": { "description": "Any JSON value" }
        }
      }
    }
  }
}
